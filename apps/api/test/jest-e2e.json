{
  "$schema": "https://json.schemastore.org/jest",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "./",
  "testEnvironment": "node",
  "testRegex": ".*.e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "../tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/../src/$1",
    "^@libs/(.*)$": "<rootDir>/../../libs/$1"
  }
}
